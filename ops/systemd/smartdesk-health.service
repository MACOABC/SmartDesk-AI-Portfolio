[Unit]
Description=SmartDesk internal health check
After=docker.service network-online.target
Wants=network-online.target
OnFailure=smartdesk-health-alert@%n.service

[Service]
Type=oneshot
User=ubuntu
Group=docker
WorkingDirectory=%h/smartdesk-ai
Environment=SMARTDESK_PROJECT_DIR=%h/smartdesk-ai
ExecStart=%h/smartdesk-ai/scripts/ops/check-health.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectControlGroups=true
