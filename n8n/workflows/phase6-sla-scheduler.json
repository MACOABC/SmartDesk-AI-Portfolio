    {
      "parameters": {
        "resource": "database",
        "operation": "executeQuery",
        "query": "SELECT * FROM public.claim_due_sla_escalations();",
        "options": {
          "queryReplacement": "={{ [] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        480,
        0
      ],
      "id": "c99d7836-5e1d-46af-8f03-c63452f494f5",
      "name": "Claim Due SLA Escalations",
      "credentials": {
        "postgres": {
          "id": "48d095ec-fbd2-49b1-95de-8710f93df5d0",
          "name": "SmartDesk PostgreSQL"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const row = $input.first().json;\nconst oneLine = (value) => String(value).replace(/[\\u0000-\\u001F\\u007F]+/g, ' ').replace(/\\s+/g, ' ').trim();\nconst message = ['⏰ SmartDesk AI — SLA VENCIDO', '', 'Ticket: ' + oneLine(row.ticket_id), 'Área: ' + oneLine(row.requester_area), 'Categoría final: ' + oneLine(row.category), 'Prioridad final: ' + oneLine(row.priority), 'Título: ' + oneLine(row.title), 'Deadline: ' + oneLine(row.due_at)].join('\\n');\nreturn [{ json: { ...row, message } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        0
      ],
      "id": "91886687-b45c-4291-a0a2-e52b0aab9b6f",
      "name": "Build SLA Escalation",
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "text": "={{ $json.message }}",
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        960,
        0
      ],
      "id": "5652c55c-43e6-4827-8aca-848a0a523ffd",
      "name": "Send SLA Escalation",
      "retryOnFail": false,
      "credentials": {
        "telegramApi": {
          "id": "VEfmIcvoGSTdQhCK",
          "name": "SmartDesk Telegram"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "resource": "database",
        "operation": "executeQuery",
        "query": "WITH event_update AS (\n  UPDATE public.automation_events SET status = 'succeeded', error_code = NULL, updated_at = CURRENT_TIMESTAMP\n  WHERE id = $1 AND sla_breach_id = $2 AND status = 'pending' RETURNING id\n), breach_update AS (\n  UPDATE public.sla_breaches SET status = 'escalated', error_code = NULL, escalated_at = CURRENT_TIMESTAMP, updated_at = CURRENT_TIMESTAMP\n  WHERE id = $2 AND status = 'pending' AND EXISTS (SELECT 1 FROM event_update) RETURNING id\n)\nSELECT (SELECT count(*) FROM event_update)::integer AS event_rows, (SELECT count(*) FROM breach_update)::integer AS breach_rows;",
        "options": {
          "queryReplacement": "={{ [ $('Build SLA Escalation').item.json.automation_event_id, $('Build SLA Escalation').item.json.breach_id ] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        1200,
        -80
      ],
      "id": "d3657ed5-e608-4d1b-a465-a6c0d94b5f4a",
      "name": "Mark SLA Escalation Succeeded",
      "credentials": {
        "postgres": {
          "id": "48d095ec-fbd2-49b1-95de-8710f93df5d0",
          "name": "SmartDesk PostgreSQL"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "resource": "database",
        "operation": "executeQuery",
        "query": "WITH event_update AS (\n  UPDATE public.automation_events SET status = 'failed', error_code = 'TELEGRAM_SEND_FAILED', updated_at = CURRENT_TIMESTAMP\n  WHERE id = $1 AND sla_breach_id = $2 AND status = 'pending' RETURNING id\n), breach_update AS (\n  UPDATE public.sla_breaches SET status = 'failed', error_code = 'TELEGRAM_SEND_FAILED', updated_at = CURRENT_TIMESTAMP\n  WHERE id = $2 AND status = 'pending' AND EXISTS (SELECT 1 FROM event_update) RETURNING id\n)\nSELECT (SELECT count(*) FROM event_update)::integer AS event_rows, (SELECT count(*) FROM breach_update)::integer AS breach_rows;",
        "options": {
          "queryReplacement": "={{ [ $('Build SLA Escalation').item.json.automation_event_id, $('Build SLA Escalation').item.json.breach_id ] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        1200,
        80
      ],
      "id": "830028c3-b8bb-4f6f-b509-63d37e9b7324",
      "name": "Mark SLA Escalation Failed",
