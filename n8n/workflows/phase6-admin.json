    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body;\nconst errors = [];\nconst uuid = /^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;\nif (typeof body.review_id !== 'string' || !uuid.test(body.review_id)) errors.push('review_id');\nif (!['approve', 'override'].includes(body.action)) errors.push('action');\nif (typeof body.reviewer !== 'string' || body.reviewer.trim().length < 1 || body.reviewer.length > 100) errors.push('reviewer');\nif (body.action === 'override') {\n  if (!['access', 'hardware', 'software', 'network', 'service_request', 'other'].includes(body.category)) errors.push('category');\n  if (!['low', 'medium', 'high', 'critical'].includes(body.priority)) errors.push('priority');\n}\nif (body.summary !== undefined && body.summary !== null && (typeof body.summary !== 'string' || body.summary.trim().length < 1 || body.summary.length > 300)) errors.push('summary');\nif (body.comment !== undefined && body.comment !== null && (typeof body.comment !== 'string' || body.comment.length > 1000)) errors.push('comment');\nreturn [{ json: { valid: errors.length === 0, errors, review_id: body.review_id ?? null, action: body.action ?? null, category: body.category ?? null, priority: body.priority ?? null, summary: body.summary ?? null, reviewer: typeof body.reviewer === 'string' ? body.reviewer.trim() : null, comment: body.comment ?? null } }];"
