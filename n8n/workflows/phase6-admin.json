    {
      "parameters": {
        "jsCode": "const outcome = $('Decide Review').first().json;\nconst oneLine = (value) => String(value).replace(/[\\u0000-\\u001F\\u007F]+/g, ' ').replace(/\\s+/g, ' ').trim();\nconst heading = outcome.priority === 'critical' ? '🚨 SmartDesk AI — CRITICAL (revisado)' : '⚠️ SmartDesk AI — HIGH (revisado)';\nconst message = [heading, '', 'Ticket: ' + oneLine(outcome.ticket_id), 'Área: ' + oneLine(outcome.requester_area), 'Categoría final: ' + oneLine(outcome.category), 'Prioridad final: ' + oneLine(outcome.priority), 'Título: ' + oneLine(outcome.title), 'Resumen final: ' + oneLine(outcome.summary), 'Revisión: ' + oneLine(outcome.review_status)].join('\\n');\nreturn [{ json: { automation_event_id: outcome.automation_event_id, prediction_id: outcome.prediction_id, message } }];"
