{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ticket-classification-schema-v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "category",
    "priority",
    "summary",
    "confidence",
    "review_required",
    "review_reason"
  ],
  "properties": {
    "category": {
      "type": "string",
      "enum": ["access", "hardware", "software", "network", "service_request", "other"]
    },
    "priority": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "review_required": {
      "type": "boolean"
    },
    "review_reason": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 500
    }
  }
}
