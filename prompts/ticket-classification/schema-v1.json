{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ticket-classification-schema-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "category",
    "priority",
    "summary"
  ],
  "properties": {
    "category": {
      "type": "string",
      "enum": [
        "access",
        "hardware",
        "software",
        "network",
        "service_request",
        "other"
      ]
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    }
  }
}
