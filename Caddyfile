{$SMARTDESK_HOST} {
	header -Server

	@webhook_probe {
		method GET
		path {$SMARTDESK_WEBHOOK_PATH}
	}

	handle @webhook_probe {
		respond 204
	}

	@ticket_webhook {
		method POST
		path {$SMARTDESK_WEBHOOK_PATH}
	}

	handle @ticket_webhook {
		rewrite * /webhook/tickets
		reverse_proxy n8n:5678
	}

	handle {
		respond 404
	}
}
